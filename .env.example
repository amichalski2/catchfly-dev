# Catchfly — local environment.
#
# Copy to `.env` and fill in. `.env` is gitignored; this file is not.
#   cp .env.example .env
#
# CATCHFLY_AUTH_MODE is required even locally so an accidental production
# misconfiguration fails closed. The remaining variables enable model analysis,
# console calibration, accounts and database access.

# --- model access -------------------------------------------------------
#
# Read by `npm run analysis` (writes cluster labels and root-cause hypotheses
# into src/data/fixtures/analysis.json) and, in production, by the Netlify
# function that analyses imported reports.


# There is no OPENROUTER_API_KEY: nothing here knows what OpenRouter is. Both
# the analysis writer and Chrome's eval CLI speak the OpenAI protocol and read
#
#
# Same three lines cover both the analysis writer and every eval model.

# Optional. Any OpenAI-compatible endpoint works — a corporate gateway, the
# Netlify AI Gateway, or OpenRouter. Leave unset to talk to OpenAI directly.
#
#
# NOTE: this one variable is shared by the analysis writer and the eval runner.
# prefix, because OpenRouter has no bare `gpt-5-mini`.

# Optional. Defaults to `gpt-5-mini`. With OpenRouter, use `openai/gpt-5-mini`.

# Kill switch for the deployed analysis endpoint. Set to `off` in Netlify to
# close it without redeploying.

# --- Devpost console calibration (`npm run evals`) ----------------------
#
# Runs Chrome's WebMCP Evals CLI against the three Devpost console manifests.
# Requires Chrome Canary/Dev 150+ as well — on Linux, the `google-chrome-unstable`
# package, which the CLI looks for at /usr/bin/google-chrome-unstable.
#
# The runner's default model is `gemini-3.5-flash`, which needs GOOGLE_AI.
# vendor instead; select a model per run:
#
#   npm run evals -- --models openai:anthropic/claude-sonnet-4.5
#
# Only fill these in if you want to reach Google or Anthropic directly rather
# than through an OpenAI-compatible gateway.
# GOOGLE_AI=
# ANTHROPIC_API_KEY=

# Defaults for `npm run evals`, overridden by --model / --runs on the command line.
# EVALS_MODEL=gemini-3.5-flash
# EVALS_RUNS=1

# --- Database (Catchfly Cloud) ---------------------------------------------
# Any PostgreSQL. Supabase, Neon, a container, your own server — the schema in
# db/migrations is plain Postgres.
#   DATABASE_URL           pooled connection, used by the functions
#   DATABASE_URL_UNPOOLED  direct connection, used by migrations and seeding
# NETLIFY_DATABASE_URL is accepted as a fallback, so a Netlify DB site needs no
# configuration at all.
# DATABASE_URL=postgresql://user:password@host:6543/postgres
# DATABASE_URL_UNPOOLED=postgresql://user:password@host:5432/postgres

# Installation bootstrap/admin secret. It creates projects, environments and
# scoped project keys. Runtime SDKs should never receive this value.
# CATCHFLY_ADMIN_KEY=

# Dashboard access is required and fails closed when missing or misspelled.
# `none` keeps the dashboard open (local/self-host); `supabase` requires accounts.
CATCHFLY_AUTH_MODE=none
# SUPABASE_URL=
# SUPABASE_JWT_SECRET=
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=

# Set to `disable` for a local/container Postgres without TLS. Catchfly detects
# localhost and the Docker Compose `db` service automatically.
# DATABASE_SSL=disable
